{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "npm"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "recreateWhen": "always",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "One lock file maintenance branch per directory",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "additionalBranchPrefix": "{{packageFileDir}}-"
    },
    {
      "description": "Only semver in before/ is of interest, reduce noise",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "matchPackageNames": [
        "!semver"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": [
        "packageManager"
      ],
      "enabled": false
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0
}
